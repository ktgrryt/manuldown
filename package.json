{
  "name": "manuldown",
  "displayName": "ManulDown",
  "description": "WYSIWYG editor for Markdown files in VSCode",
  "icon": "images/icon.png",
  "version": "2.4.4",
  "publisher": "ktgrryt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktgrryt/manuldown.git"
  },
  "bugs": {
    "url": "https://github.com/ktgrryt/manuldown/issues"
  },
  "homepage": "https://github.com/ktgrryt/manuldown#readme",
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "custom-editor",
    "preview"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:manulDown.editor",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "manulDown.editor",
        "displayName": "ManulDown",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "manulDown.openEditor",
        "title": "Open with ManulDown Editor",
        "category": "ManulDown",
        "icon": "$(edit)"
      },
      {
        "command": "manulDown.openTextEditor",
        "title": "Open with Text Editor",
        "category": "ManulDown",
        "icon": "$(code)"
      },
      {
        "command": "manulDown.toggleEditor",
        "title": "Toggle ManulDown / Text Editor",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.cursorUp",
        "title": "Cursor Up (ManulDown)",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.findInEditor",
        "title": "Find in ManulDown Editor",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.insertWorkspaceLink",
        "title": "Insert Link",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.openInsertMenu",
        "title": "Open Insert Command Menu",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.openLinkAtCursor",
        "title": "Open Link at Cursor",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.copyAsMarkdown",
        "title": "Copy as Markdown",
        "category": "ManulDown",
        "enablement": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.undo",
        "title": "Undo in ManulDown Editor",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.redo",
        "title": "Redo in ManulDown Editor",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.cursorRight",
        "title": "Cursor Right (ManulDown)",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.insertRowAbove",
        "title": "Table: Insert Row Above",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.insertRowBelow",
        "title": "Table: Insert Row Below",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.insertColumnLeft",
        "title": "Table: Insert Column Left",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.insertColumnRight",
        "title": "Table: Insert Column Right",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.selectCurrentColumn",
        "title": "Table: Select Current Column",
        "category": "ManulDown"
      },
      {
        "command": "manulDown.table.selectCurrentRow",
        "title": "Table: Select Current Row",
        "category": "ManulDown"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "manulDown.copyAsMarkdown",
          "when": "webviewId == 'manulDown.editor' && webviewSection == 'editor' && manulDownHasMarkdownSelection",
          "group": "clipboard@10"
        }
      ],
      "commandPalette": [
        {
          "command": "manulDown.copyAsMarkdown",
          "when": "activeCustomEditorId == 'manulDown.editor'"
        }
      ],
      "editor/title": [
        {
          "command": "manulDown.openEditor",
          "when": "resourceLangId == markdown && activeCustomEditorId != 'manulDown.editor'",
          "group": "navigation"
        },
        {
          "command": "manulDown.openTextEditor",
          "when": "activeCustomEditorId == 'manulDown.editor'",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "manulDown.toggleEditor",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "resourceLangId == markdown || activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.cursorUp",
        "key": "ctrl+p",
        "mac": "ctrl+p",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.findInEditor",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.insertWorkspaceLink",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.openInsertMenu",
        "key": "alt+/",
        "mac": "ctrl+/",
        "when": "activeCustomEditorId == 'manulDown.editor' && !accessibleViewIsShown"
      },
      {
        "command": "manulDown.openLinkAtCursor",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.copyAsMarkdown",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "activeCustomEditorId == 'manulDown.editor' && manulDown.editorTextFocus",
        "args": {
          "fromShortcut": true
        }
      },
      {
        "command": "manulDown.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.redo",
        "key": "ctrl+y",
        "when": "!isMac && activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.cursorRight",
        "key": "ctrl+f",
        "mac": "ctrl+f",
        "when": "isMac && activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.insertRowAbove",
        "key": "ctrl+shift+alt+up",
        "mac": "cmd+ctrl+shift+up",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.insertRowBelow",
        "key": "ctrl+shift+alt+down",
        "mac": "cmd+ctrl+shift+down",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.insertColumnLeft",
        "key": "ctrl+shift+alt+left",
        "mac": "cmd+ctrl+shift+left",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.insertColumnRight",
        "key": "ctrl+shift+alt+right",
        "mac": "cmd+ctrl+shift+right",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.selectCurrentColumn",
        "key": "ctrl+alt+up",
        "mac": "ctrl+shift+alt+up",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.selectCurrentColumn",
        "key": "ctrl+alt+down",
        "mac": "ctrl+shift+alt+down",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.selectCurrentRow",
        "key": "ctrl+alt+left",
        "mac": "ctrl+shift+alt+left",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      },
      {
        "command": "manulDown.table.selectCurrentRow",
        "key": "ctrl+alt+right",
        "mac": "ctrl+shift+alt+right",
        "when": "activeCustomEditorId == 'manulDown.editor'"
      }
    ],
    "configuration": {
      "title": "ManulDown",
      "properties": {
        "manulDown.pdf.browserPath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Path to the Google Chrome, Microsoft Edge, or Chromium executable used for PDF export and rendering illustrations in Word documents. Leave empty to detect an installed browser automatically."
        },
        "manulDown.images.moveWithDocument": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically move referenced images in `images/<document-name>/` when moving or renaming a Markdown file in VS Code. Turn this off to keep images in their original location. Shared images are copied, existing destination files are preserved, and empty source image folders are removed. Requires `#markdown.updateLinksOnFileMove.enabled#` to be `never`."
        },
        "manulDown.toolbar.visible": {
          "type": "boolean",
          "default": true,
          "description": "Show the toolbar."
        },
        "manulDown.toolbar.items": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "bold": true,
            "italic": true,
            "strikethrough": true,
            "inlinecode": true,
            "h1": true,
            "h2": true,
            "h3": true,
            "h4": false,
            "h5": false,
            "h6": false,
            "ul": true,
            "ol": true,
            "checkbox": true,
            "quote": true,
            "codeblock": true,
            "table": true,
            "link": false,
            "image": false,
            "footnote": false,
            "math": false,
            "mathblock": false
          },
          "properties": {
            "bold": {
              "type": "boolean",
              "default": true,
              "description": "Bold"
            },
            "italic": {
              "type": "boolean",
              "default": true,
              "description": "Italic"
            },
            "strikethrough": {
              "type": "boolean",
              "default": true,
              "description": "Strikethrough"
            },
            "inlinecode": {
              "type": "boolean",
              "default": true,
              "description": "Inline Code"
            },
            "h1": {
              "type": "boolean",
              "default": true,
              "description": "H1"
            },
            "h2": {
              "type": "boolean",
              "default": true,
              "description": "H2"
            },
            "h3": {
              "type": "boolean",
              "default": true,
              "description": "H3"
            },
            "h4": {
              "type": "boolean",
              "default": false,
              "description": "H4"
            },
            "h5": {
              "type": "boolean",
              "default": false,
              "description": "H5"
            },
            "h6": {
              "type": "boolean",
              "default": false,
              "description": "H6"
            },
            "ul": {
              "type": "boolean",
              "default": true,
              "description": "Bullet List"
            },
            "ol": {
              "type": "boolean",
              "default": true,
              "description": "Numbered List"
            },
            "checkbox": {
              "type": "boolean",
              "default": true,
              "description": "Task List"
            },
            "quote": {
              "type": "boolean",
              "default": true,
              "description": "Quote"
            },
            "codeblock": {
              "type": "boolean",
              "default": true,
              "description": "Code Block"
            },
            "table": {
              "type": "boolean",
              "default": true,
              "description": "Table"
            },
            "link": {
              "type": "boolean",
              "default": false,
              "description": "Link"
            },
            "image": {
              "type": "boolean",
              "default": false,
              "description": "Image"
            },
            "footnote": {
              "type": "boolean",
              "default": false,
              "description": "Footnote"
            },
            "math": {
              "type": "boolean",
              "default": false,
              "description": "Inline Math"
            },
            "mathblock": {
              "type": "boolean",
              "default": false,
              "description": "Math Block"
            }
          },
          "markdownDescription": "Choose the buttons shown in the toolbar. Changes apply immediately. Unchecked buttons are also hidden from the **…** menu; their slash commands and keyboard shortcuts remain available. Export and Settings always remain in **…**."
        },
        "manulDown.callout.defaultService": {
          "type": "string",
          "default": "github",
          "enum": ["github", "qiita", "zenn", "obsidian", "container", "mkdocs", "gitbook", "myst", "quarto"],
          "enumItemLabels": ["GitHub / GitLab / Microsoft Learn", "Qiita", "Zenn", "Obsidian", "Docusaurus / VitePress", "MkDocs", "GitBook", "MyST / Jupyter Book", "Quarto"],
          "description": "Initial service for /callout in each VS Code window. Choosing a service in a callout's format menu sets the service for new callouts across that window until it is reloaded or restarted."
        },
        "manulDown.toc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the table of contents when headings exist."
        },
        "manulDown.openByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Open Markdown files with ManulDown by default."
        },
        "manulDown.list.dashStyle": {
          "type": "boolean",
          "default": false,
          "description": "Use a dash (-) as the bullet marker style."
        },
        "manulDown.list.indentSize": {
          "type": "number",
          "default": 2,
          "enum": [
            2,
            4
          ],
          "enumDescriptions": [
            "Indent nested list items with 2 spaces.",
            "Indent nested list items with 4 spaces."
          ],
          "description": "Default indentation width for nested list items when no existing list indentation style can be detected."
        },
        "manulDown.security.allowRemoteImages": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Allow ManulDown to load remote http/https images inside the editor. Disabled by default to avoid automatic outbound requests when a document is opened."
        },
        "manulDown.security.allowRemoteImageImport": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Allow pasted or dropped remote http/https image URLs to be downloaded into the workspace."
        },
        "manulDown.security.allowFileLinks": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "Allow file:// links and local file links outside the current workspace folder to be opened from ManulDown. Disabled by default because file links can open local files, applications, or network shares."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:webview && tsc -p ./ && node scripts/bundle-host.js --minify",
    "bundle:webview": "esbuild media/vendor/mermaid-entry.js --bundle --platform=browser --format=iife --minify --legal-comments=inline --outfile=media/vendor/mermaid.bundle.js && esbuild editor-selection.bundle=src/editor/EditorSelection.ts image-size.bundle=src/editor/ImageSize.ts callout-manager.bundle=media/modules/CalloutManager.js --bundle --platform=browser --format=esm --minify --outdir=media/vendor && node scripts/bundle-prism.js && node scripts/bundle-katex.js && node scripts/bundle-pdfjs.js && node scripts/bundle-icons.js",
    "bundle:host": "node scripts/bundle-host.js",
    "compile": "npm run bundle:webview && tsc -p ./ && npm run bundle:host",
    "watch": "npm run bundle:webview && tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js",
    "test:pdf": "npm run compile && node --test test/browser/*.test.js",
    "lint": "eslint src media",
    "package:vsix": "vsce package --githubBranch main",
    "publish:vsce": "vsce publish --githubBranch main"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.2",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "^6.5.438",
    "tinyglobby": "file:scripts/toolchain-glob",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "katex": "$katex",
    "tinyglobby": "$tinyglobby",
    "minimatch@^10.0.0": "11.0.4"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "docx": "^9.15.4",
    "marked": "^11.1.1",
    "pdf-lib": "^1.17.1",
    "prismjs": "^1.30.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
